      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B07 Responsable de despacho" id="ROL-B07">
      <documentation>Verifica estados por separado, carga y entrega</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B08 Transportista receptor" id="ROL-B08">
      <documentation>Acepta u observa la entrega del FCL</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="BF-01 Recepción de materia prima" id="BF-01">
      <documentation>Función de negocio que agrupa la recepción de bins con identidad de origen (BP-01). Crea y lee Lot y HarvestOrigin (C1/Dato_x_Funcion). Fuente: B-05. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Sin vista"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="BF-02 Producción de packing" id="BF-02">
      <documentation>Función de negocio de calibrado, empaque y cierre de pallet (BP-02). Crea batches, pallets y genealogía (C1/Dato_x_Funcion). Fuente: B-05. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Sin vista"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="BF-03 Aseguramiento de calidad" id="BF-03">
      <documentation>Función de negocio de inspección y decisión de conformidad (BP-03); solo ROL-B05 crea o cambia QAResult (PR-07). Fuente: B-05; C1/Dato_x_Funcion. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Sin vista"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="BF-04 Gestión de frío" id="BF-04">
      <documentation>Función de negocio de pre-frío, almacenamiento en cámara y custodia térmica (BP-05, BP-06; etapas VS-S4 y VS-S5). Crea TempReading y ColdCustody. Fuente: B-05. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Sin vista"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="BF-05 Despacho y exportación" id="BF-05">
      <documentation>Función de negocio de carga del FCL, verificación de estados y entrega al transportista (BP-07). Lee QAResult; no lo cambia. Fuente: B-05. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Sin vista"/>
    </element>
    <element xsi:type="archimate:BusinessFunction" name="BF-06 Mejora continua" id="BF-06">
      <documentation>Función de medición y mejora: KPI, excepciones y conciliación (BP-08). Lee DOBJ-05/06/09/10/12 para medir. Fuente: B-05; C1/Dato_x_Funcion. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Sin vista"/>
    </element>
