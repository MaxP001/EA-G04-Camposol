<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Camposol Chao · Preliminary, Phase A, Phase B, Phase C y Phase D · v3.0" id="M-CAMPOSOL-ABCD-v30" version="5.0.0">
  <folder name="Strategy" id="id-c6e509994b3e4fef8e479ac8dbbd772a" type="strategy">
    <element xsi:type="archimate:ValueStream" name="VS-01 Aseguramiento de fruta exportable" id="VS-01">
      <documentation>Value stream único del expediente (nombre de PC2, DEC-PC3-01). Alcance: desde la recepción de bins en packing hasta la entrega del FCL refrigerado al transportista en rampa. Propuesta de valor: arándanos exportables con identidad, conformidad y frío demostrables. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:ValueStream" name="VS-S1 Recepcionar bins" id="VS-S1">
      <documentation>Entra: Bins con guía de remisión e identidad de origen (fundo, sector, fecha y lote de cosecha). Criterio de frontera del handoff Cosecha → Packing. | Acción: Pesar, verificar documentos y asignar identidad de lote de planta vinculada al origen. | Salida: Lote de recepción aceptado, o excepción registrada si falta el origen. | Valor: El origen queda demostrable desde el ingreso. | Actor: Recepción (ROL-B03)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:ValueStream" name="VS-S2 Calibrar y empacar" id="VS-S2">
      <documentation>Entra: Lote de recepción aceptado. | Acción: Seleccionar y calibrar, registrar divisiones y mezclas de lotes en batches, empacar y paletizar. | Salida: Pallets cerrados ligados a todos sus lotes de origen (genealogía N:M). | Valor: Cada caja conserva su composición y origen. | Actor: Packing (ROL-B04)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:ValueStream" name="VS-S3 Verificar conformidad" id="VS-S3">
      <documentation>Entra: Pallet cerrado con genealogía y muestra según plan de muestreo. | Acción: Inspeccionar y decidir: liberar, retener (HOLD) o rechazar. | Salida: Decisión de Calidad registrada con aprobador, fecha y motivo. | Valor: Despacho trabaja con evidencia confiable y autorizada. | Actor: Aseguramiento de Calidad (ROL-B05, autoridad exclusiva)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:ValueStream" name="VS-S4 Pre-enfriar según ruta" id="VS-S4">
      <documentation>Entra: Pallet identificado con ruta térmica asignada. | Acción: Aplicar pre-frío y abrir la serie térmica del pallet. | Salida: Pallet a temperatura objetivo con serie iniciada. | Valor: Inicia la cadena de frío demostrable. | Actor: Frío (ROL-B06)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:ValueStream" name="VS-S5 Custodiar en cámara" id="VS-S5">
      <documentation>Entra: Pallet pre-enfriado. | Acción: Ubicar, registrar posición y serie térmica continua, y transferir custodia. | Salida: Pallet con custodia y serie válidas hasta la carga. | Valor: Integridad térmica verificable por pallet. | Actor: Frío (ROL-B06)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:ValueStream" name="VS-S6 Cargar y entregar FCL" id="VS-S6">
      <documentation>Entra: Pallets liberados por Calidad y con condición térmica válida. | Acción: Verificar por separado ambos estados, cargar, precintar y entregar. | Salida: FCL entregado con acta de handoff aceptada por el transportista. | Valor: El comprador recibe fruta conforme con evidencia. | Actor: Despacho (ROL-B07)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-01 Trazabilidad del lote" id="CAP-01">
      <documentation>Habilidad de identificar cada unidad física y reconstruir su historia y genealogía desde la recepción hasta el FCL.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-02 Gestión de evidencia operativa" id="CAP-02">
      <documentation>Habilidad de capturar, conservar y reconciliar los eventos de negocio con fuente, instante y responsable, incluso ante cortes.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-03 Gestión de la cadena de frío" id="CAP-03">
      <documentation>Habilidad de mantener y demostrar la condición térmica y la custodia de cada pallet.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-04 Coordinación de transferencias" id="CAP-04">
      <documentation>Habilidad de transferir unidades e información entre áreas con emisor, receptor, aceptación y excepción explícitos.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-05 Medición del desempeño y mejora" id="CAP-05">
      <documentation>Habilidad de medir indicadores con ficha, owner, fuente y frecuencia, y actuar sobre desviaciones.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-06 Gestión de excepciones de negocio" id="CAP-06">
      <documentation>Habilidad de registrar, escalar y cerrar discrepancias con autoridad, causa y evidencia.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Capability" name="CAP-07 Control de conformidad y liberación" id="CAP-07">
      <documentation>Habilidad de inspeccionar el producto y decidir liberar, retener o rechazar con autoridad exclusiva y evidencia.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:CourseOfAction" name="CoA-01 Gobernar identidad y evidencia por pallet en cada transferencia" id="CoA-01">
      <documentation>Realiza OUT-01 y OUT-02; lo habilitan CAP-01, CAP-04 y CAP-07</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="A / B"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
  </folder>
  <folder name="Business" id="id-9f90a0e29c2441eaad60eed5e60806f9" type="business">
    <element xsi:type="archimate:BusinessActor" name="ACT-01 Operaciones de planta" id="ACT-01">
