    </element>
    <element xsi:type="archimate:Stakeholder" name="STK-06 Despacho y Exportación" id="STK-06">
      <documentation>Jefe de Despacho/Exportaciones (cargo tipo, S)</documentation>
      <property key="Evidencia" value="SV (cargo tipo)"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Stakeholder" name="STK-07 Transformación Digital" id="STK-07">
      <documentation>Dirección corporativa de Transformación Digital (cargo tipo, S)</documentation>
      <property key="Evidencia" value="SV (cargo tipo)"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Driver" name="DRV-01 Riesgo comercial por incidentes de calidad y frío en destino" id="DRV-01">
      <documentation>Clase IA; IA-02; F05 (P, certificaciones)</documentation>
      <property key="Evidencia" value="IA"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Driver" name="DRV-02 Exigencias de trazabilidad y cumplimiento de mercados y SENASA" id="DRV-02">
      <documentation>Clase HP; F05; F08 (aplicabilidad local NV-08)</documentation>
      <property key="Evidencia" value="HP"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Driver" name="DRV-03 Fragmentación de la evidencia operativa entre etapas" id="DRV-03">
      <documentation>Clase IA; DS-CS-02; DS-CS-04</documentation>
      <property key="Evidencia" value="IA"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Driver" name="DRV-04 Presión de coordinación por duplicación de capacidad en Chao" id="DRV-04">
      <documentation>Clase HP; F03</documentation>
      <property key="Evidencia" value="HP (ampliación, F03) / SV (presión de coordinación, SV-09)"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Goal" name="GOAL-01 Asegurar integridad y reconstrucción oportuna de la evidencia del lote" id="GOAL-01">
      <documentation>Meta derivada de DRV-01, DRV-02 y DRV-03: que la evidencia del lote sea íntegra y se reconstruya a tiempo. Se concreta en OUT-01 y se mide con KPI-01, KPI-02, KPI-03 y KPI-06. Fuente: Estrategia_Catalog.csv. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Goal" name="GOAL-02 Asegurar handoffs y estados consistentes entre áreas" id="GOAL-02">
      <documentation>Meta derivada de DRV-02 y DRV-04: transferencias entre áreas con aceptación explícita y estados de Calidad y Despacho que no se contradicen. Se concreta en OUT-02 y se mide con KPI-04. Fuente: Estrategia_Catalog.csv. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Goal" name="GOAL-03 Sostener la coordinación interáreas y la gestión de excepciones en picos" id="GOAL-03">
      <documentation>Meta derivada de DRV-04: sostener la coordinación y la gestión de excepciones en los picos de campaña. Se concreta en OUT-03 y se mide con KPI-05 y KPI-07. Fuente: Estrategia_Catalog.csv. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Outcome" name="OUT-01 Historia del lote íntegra, segura y recuperable para decisiones" id="OUT-01">
      <documentation>Resultado esperado de GOAL-01: historia del lote íntegra, segura y recuperable. KPI-01 historia revisada ≤ 30 min (Baseline IA 120 min); KPI-02 ≥ 95 % de pallets con serie térmica y custodia (Baseline IA 65 %). Fuente: Estrategia_Catalog.csv. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Outcome" name="OUT-02 Handoffs con aceptación y excepción explícitas y estados separados" id="OUT-02">
      <documentation>Resultado esperado de GOAL-02: handoffs con aceptación y excepción explícitas y estados separados. KPI-04 ≥ 95 % de handoffs completos al primer intento (Baseline IA 78 %). Fuente: Estrategia_Catalog.csv. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Outcome" name="OUT-03 Excepciones gestionadas y desempeño medido de forma gobernada" id="OUT-03">
      <documentation>Resultado esperado de GOAL-03: excepciones gestionadas y desempeño medido de forma gobernada. KPI-05 100 % de excepciones cerradas con causa y responsable; KPI-07 7/7 indicadores gobernados. Fuente: Estrategia_Catalog.csv. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Principle" name="PR-02 Identidad canónica y genealogía del lote" id="PR-02">
      <documentation>Cada unidad física (lote de recepción, batch, pallet, FCL) tendrá una identidad única y no reutilizable, vinculada a su origen de cosecha y a todas sus unidades padre e hijas.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Principle" name="PR-03 Evidencia con responsable y procedencia" id="PR-03">
      <documentation>Todo registro que sustente una decisión de calidad, frío o despacho tendrá fuente, instante con zona horaria, autor y un owner de negocio identificado.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Principle" name="PR-05 Valor antes que tecnología" id="PR-05">
      <documentation>Ningún componente tecnológico se seleccionará ni presupuestará sin un gap, un requisito y un criterio de aceptación que lo justifiquen.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Principle" name="PR-06 Continuidad operativa y acceso seguro" id="PR-06">
      <documentation>La captura de evidencia en planta no dependerá de la disponibilidad del enlace externo, y todo acceso a la evidencia será autorizado y auditado.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Principle" name="PR-07 Autoridad humana exclusiva de liberación" id="PR-07">
      <documentation>Solo el rol Aprobador de Calidad puede liberar, retener o rechazar un lote; ningún sistema, algoritmo ni otra área adquiere esa autoridad.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Principle" name="PR-08 Interoperabilidad por contrato" id="PR-08">
      <documentation>Los intercambios de información entre áreas y sistemas se regirán por contratos con significado, versión, emisor, receptor y tratamiento de errores definidos.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-01 Identidad y genealogía" id="REQ-01">
      <documentation>Todo pallet despachado deberá vincularse a todos sus lotes de recepción y a su origen de cosecha, incluidas divisiones y mezclas, sin unidades huérfanas.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-02 Historia recuperable" id="REQ-02">
      <documentation>La historia completa de un pallet deberá entregarse revisada por Calidad en ≤ 30 min desde la solicitud completa.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-03 Continuidad y reconciliación" id="REQ-03">
      <documentation>Ante un corte del enlace externo, los eventos de planta deberán conservarse y reconciliarse sin pérdida, duplicado efectivo ni huérfanos.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-04 Evidencia térmica y custodia" id="REQ-04">
      <documentation>Cada pallet despachado deberá contar con serie térmica válida e identidad y custodia trazables desde el pre-frío hasta el handoff.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-05 Acceso autorizado y auditoría" id="REQ-05">
      <documentation>Solo los roles autorizados deberán acceder o modificar la evidencia, y cada acceso deberá quedar trazado con actor, instante y acción.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-06 Handoff y estados diferenciados" id="REQ-06">
      <documentation>Cada transferencia deberá registrar emisor, receptor, unidad, información, aceptación u observación; la liberación de Calidad y la condición de Despacho deberán ser estados distintos.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-07 Medición gobernada" id="REQ-07">
      <documentation>Cada indicador del alcance deberá tener ficha con fórmula, población, fuente, owner y frecuencia, y medición periódica vigente.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Requirement" name="REQ-08 Excepciones con autoridad y cierre" id="REQ-08">
      <documentation>Toda excepción (HOLD, desviación térmica, faltante de origen, discrepancia de handoff) deberá registrarse con autoridad, causa, acción y cierre con evidencia.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Constraint" name="CNS-01 Sin producto ni marca antes de Phase E" id="CNS-01">
      <documentation>Restricción de ARS-01 §2.9: los SBB solo se comparan (T1/13); la selección corresponde a Phase E. Deriva de PR-05. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Constraint" name="CNS-02 Solo ROL-B05 crea o cambia un estado de Calidad" id="CNS-02">
      <documentation>Restricción de ARS-01 §2.9: ninguna aplicación, nodo, integración ni IA libera; deriva de PR-07 (DEC-D12). Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
    <element xsi:type="archimate:Constraint" name="CNS-06 SAP solo lee el estado QA y confirma embarques" id="CNS-06">
      <documentation>Restricción de ARS-01 §2.9: SAP queda fuera del rediseño; lee el estado por IF-05 y confirma por IF-06; nunca escribe el estado de Calidad (NFR-T11). Clase HP (SAP: F01/F02) / DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="Preliminary / A"/>
      <property key="Estado" value="N/A (motivación, estrategia o migración)"/>
    </element>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-e75c214c019a4f6c93ba4a2743262abd" type="implementation_migration">
    <element xsi:type="archimate:Gap" name="GAP-T01 Captura y persistencia ante corte WAN" id="GAP-T01">
      <documentation>Baseline: Papel durante cortes de hasta 3 h; 9/41 eventos con defecto; sin cola local (DS-CS-07/26/37). Target: T-TAR03 + T-TAR19/20 (borde persistente y réplica). Resolución: Borde persistente ≥ 24 h, reenvío idempotente y consulta local de estado QA. · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:Gap" name="GAP-T02 Separación de redes IT/OT" id="GAP-T02">
      <documentation>Baseline: LAN plana con oficina, calibradoras y frío (DS-CS-36). Target: Z-01…Z-07; CD-01…CD-09; T-TAR06/07; T-TAR14…18. Resolución: Zonas y conductos registrados; control OT local sin mando remoto. · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:Gap" name="GAP-T03 Identidad técnica y acceso" id="GAP-T03">
      <documentation>Baseline: Cuentas compartidas en OT; planilla editable por 14 usuarios (DS-CS-09/39). Target: T-TAR12 + TS-06. Resolución: Cuentas nominales por rol, MFA remoto, identidad de dispositivo y auditoría QA. · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:Gap" name="GAP-T04 Recuperabilidad de la plataforma" id="GAP-T04">
      <documentation>Baseline: Servidor único; respaldo semanal sin prueba de restauración (DS-CS-35/38). Target: T-TAR08…11 + TS-08/09. Resolución: Plataforma central con RTO/RPO, respaldo inmutable, observabilidad y versionado. · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:Gap" name="GAP-T05 Tiempo de referencia" id="GAP-T05">
      <documentation>Baseline: Relojes sin fuente común; deriva de hasta 4 min (DS-CS-22/40). Target: T-TAR05 + TS-07 + CD-09. Resolución: Servidor de tiempo de planta; desviación ≤ 1 s; zona explícita. · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:Gap" name="GAP-T06 Almacenamiento y retención de evidencias" id="GAP-T06">
      <documentation>Baseline: Carpeta compartida sin política de retención (DS-CS-24). Target: T-TAR10 + TS-05. Resolución: Almacén append-only con integridad y retención configurable (NV-09). · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:Gap" name="GAP-T07 Integración con SAP" id="GAP-T07">
      <documentation>Baseline: Digitación manual desde la planilla puente; mecanismo SAP desconocido (DS-CS-41). Target: T-TAR23 + TS-10 + CD-07. Resolución: Conducto central único con IF-05/IF-06; mecanismo por validar. · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:Gap" name="GAP-T08 Vínculo lectura térmica–pallet" id="GAP-T08">
      <documentation>Baseline: CSV nocturno en UTC sin vínculo sonda–pallet; vacío de 3 h en P14 (DS-CS-17/22/34). Target: T-TAR04 + TS-01 + DOBJ-08 ColdCustody. Resolución: Lectura continua por gateway con posición, pallet, calibración y gapFlag. · Estado: Target (nuevo) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B–D (insumo E)"/>
      <property key="Estado" value="Target (nuevo)"/>
    </element>
    <element xsi:type="archimate:WorkPackage" name="TD-RC01 Diagnóstico e inventario IT/OT pasivo (candidato)" id="TD-RC01">
      <documentation>Horizonte relativo 0–1 meses, prioridad P0. Criterio de salida: Inventario de activos, flujos y sondas; NV-04/NV-05 respondidas. Depende de: Sin escaneo activo de PLC; acceso a sala técnica. Sin presupuesto ni fechas. · Estado: Target (nuevo) · Clase DE</documentation>
