      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="ACT-07 Transportista" id="ACT-07">
      <documentation>Externo: receptor inmediato del FCL</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B01 Gestor de evidencia" id="ROL-B01">
      <documentation>Prepara y entrega la historia del lote; steward propuesto de la evidencia (Target, nuevo)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B02 Responsable de medición" id="ROL-B02">
      <documentation>Mantiene fichas y medición de KPI (Target, nuevo)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B03 Operador de recepción" id="ROL-B03">
      <documentation>Registra origen y crea el lote de recepción</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B04 Supervisor de packing" id="ROL-B04">
      <documentation>Registra calibrado, divisiones, mezclas y paletizado</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B05 Aprobador de Calidad" id="ROL-B05">
      <documentation>Decide liberar, retener o rechazar (autoridad exclusiva)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessRole" name="ROL-B06 Custodio de frío" id="ROL-B06">
