      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessEvent" name="EV-06 Corte de enlace externo" id="EV-06">
      <documentation>Activa registro en contingencia y reconciliación (REQ-03)</documentation>
