      <documentation>Medición e indicadores</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessActor" name="ACT-06 Fundo proveedor" id="ACT-06">
