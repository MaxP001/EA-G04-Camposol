      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Ambos; Gap: Included (modificado)"/>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="BP-08 Gestionar excepción de negocio" id="BP-08">
      <documentation>Estado: Target; Gap: New</documentation>
