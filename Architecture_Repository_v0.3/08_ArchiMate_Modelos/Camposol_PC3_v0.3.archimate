    <element xsi:type="archimate:BusinessService" name="BSV-05 Decisión de conformidad" id="BSV-05">
      <documentation>Estado: Ambos; Gap: Included (modificado)</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Ambos; Gap: Included (modificado)"/>
    </element>
    <element xsi:type="archimate:BusinessService" name="BSV-06 Consulta ad hoc de registros" id="BSV-06">
      <documentation>Estado: Baseline; Gap: Eliminated</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Baseline; Gap: Eliminated"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-01 Lote" id="BO-01">
      <documentation>Identidad de planta del lote de recepción, batch y pallet, con referencia de origen (fundo, sector, fecha y lote de cosecha) y códigos locales.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-02 Genealogía del lote" id="BO-02">
      <documentation>Relaciones padre/hijo N:M fechadas por división o mezcla entre lote de recepción, batch, pallet y FCL.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-03 Resultado de inspección" id="BO-03">
      <documentation>Estado (liberado, retenido HOLD, rechazado), aprobador, fecha, motivo y muestra; decisión exclusiva de Calidad.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-04 Condición de despacho" id="BO-04">
      <documentation>Decisión de carga/precinto de Despacho; no deriva automáticamente de BO-03.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-05 Serie térmica y custodia" id="BO-05">
      <documentation>Lecturas con fuente, reloj, intervalo y unidad; posición en cámara y transferencias de custodia.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-06 Acta de handoff" id="BO-06">
      <documentation>Emisor, receptor, unidad, información, instante, aceptación u observación.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-07 Registro de evento de negocio" id="BO-07">
      <documentation>Evento con lote, tipo, instante con zona, fuente y actor; base de la historia.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-08 Registro de excepción" id="BO-08">
      <documentation>Discrepancia, impacto, autoridad, tratamiento, cierre y evidencia.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:BusinessObject" name="BO-09 Planilla puente de conciliación" id="BO-09">
      <documentation>Planilla compartida que concilia códigos de recepción, packing y cámara a mano.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="B"/>
      <property key="Estado" value="Baseline"/>
    </element>
  </folder>
  <folder name="Application" id="id-4e7be8105b8345ae946b427b3fc4489e" type="application">
    <element xsi:type="archimate:ApplicationService" name="ASV-C01 Registro de eventos de negocio (candidato)" id="ASV-C01">
