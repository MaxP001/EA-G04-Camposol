      <property key="Evidencia" value="DE (candidato)"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="ASV-C02 Consulta de historia del lote (candidato)" id="ASV-C02">
      <documentation>Servicio lógico candidato para BSV-01. Sin producto.</documentation>
      <property key="Evidencia" value="DE (candidato)"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:DataObject" name="DO-C01 Historia del lote (conceptual)" id="DO-C01">
      <documentation>Objeto de datos conceptual; Phase C lo detalla (Lot, LotEvent, LotGenealogy).</documentation>
      <property key="Evidencia" value="DE (candidato)"/>
      <property key="Fase_ADM" value="C (Data)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-01 Registro de recepción (planilla)" id="AP-01">
      <documentation>Baseline · Registrar bins y origen · Disposición: Modernizar captura (candidato; decisión en Phase E) · Clase IA</documentation>
      <property key="Evidencia" value="IA"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-02 Sistema de la calibradora" id="AP-02">
      <documentation>Baseline · Calibrar y registrar batches, división y mezcla · Disposición: Mantener + adaptador de eventos · Clase HP existencia (F04)</documentation>
      <property key="Evidencia" value="HP existencia (F04)"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-03 Planilla de packing" id="AP-03">
      <documentation>Baseline · Registrar pallets y composición · Disposición: Modernizar captura (candidato) · Clase IA</documentation>
      <property key="Evidencia" value="IA"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-04 Registro de Calidad (planilla)" id="AP-04">
      <documentation>Baseline · Registrar inspección y decisión · Disposición: Modernizar captura (candidato) conservando autoridad · Clase IA</documentation>
      <property key="Evidencia" value="IA"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-05 Registro térmico de cámaras" id="AP-05">
      <documentation>Baseline · Registrar temperatura por posición · Disposición: Integrar por contrato si NV-05 confirma la fuente · Clase IA / NV-05</documentation>
      <property key="Evidencia" value="IA / NV-05"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-06 SAP corporativo" id="AP-06">
      <documentation>Baseline · Embarque y documentación de exportación · Disposición: Mantener; consumir historia y estado QA sin liberar · Clase HP (F01/F02)</documentation>
      <property key="Evidencia" value="HP (F01/F02)"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Baseline y Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-07 Planilla puente" id="AP-07">
      <documentation>Baseline · Conciliar códigos a mano · Disposición: Eliminar tras gate (M-04) · Clase IA</documentation>
      <property key="Evidencia" value="IA"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Baseline"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-08 Ingesta y adaptadores de eventos" id="AP-08">
      <documentation>Target · Validar contrato, deduplicar y correlacionar eventos · Disposición: Incorporar (ABB lógico, sin producto) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-09 Componente de trazabilidad" id="AP-09">
      <documentation>Target · Componer identidad, genealogía e historia; publicar estado QA · Disposición: Incorporar (ABB lógico) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-10 Portal de consulta de evidencia" id="AP-10">
      <documentation>Target · Consulta autorizada de la historia por rol · Disposición: Incorporar (ABB lógico) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationComponent" name="AP-11 Monitor de excepciones y calidad de datos" id="AP-11">
      <documentation>Target · Excepciones, reconciliación y reglas DQ · Disposición: Incorporar (ABB lógico) · Clase DE</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="AF-01 Validar y reconciliar eventos" id="AF-01">
      <documentation>Función de AP-08: valida eventos contra contrato, deduplica por clave de hecho y reconcilia faltantes (AR-A01, AR-A04). Realiza ASV-01. Fuente: C2/App_x_Funcion_Aplicacion. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="AF-02 Componer historia del lote" id="AF-02">
      <documentation>Función de AP-09: compone la historia del lote (identidad, genealogía, eventos, QA y frío) en LotHistory (DOBJ-12). Realiza ASV-02. Fuente: C2/App_x_Funcion_Aplicacion. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="AF-03 Publicar estado de inspección" id="AF-03">
      <documentation>Función de AP-09: publica el estado de inspección registrado por Calidad, en solo lectura para Despacho y SAP (AR-A05). Realiza ASV-03. Fuente: C2/App_x_Funcion_Aplicacion. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationFunction" name="AF-04 Gestionar excepciones y calidad de datos" id="AF-04">
      <documentation>Función de AP-11: registra excepciones con causa, responsable y cierre, y controla reglas de calidad de datos (AR-D06, AR-A06). Realiza ASV-04. Fuente: C2. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="ASV-01 Registro de eventos de lote" id="ASV-01">
      <documentation>Servicio de aplicación que recibe eventos de lote por contrato IF-01…04/06 y confirma su registro (AR-A01). Lo usan las fuentes de planta (UC-C03). Fuente: ARS-01 §2.3; C2. Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="ASV-02 Consulta autorizada de historia" id="ASV-02">
      <documentation>Servicio de consulta autorizada y auditada de la historia del lote por IF-05 (AR-A02, AR-A03); meta ≤ 30 min de extremo a extremo (KPI-01). Lo consumen ROL-B05 y ROL-B07 (UC-C01). Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="ASV-03 Consulta de estado de inspección" id="ASV-03">
      <documentation>Servicio de consulta del estado de inspección (LIBERADO/HOLD) en solo lectura para Despacho y SAP por IF-05; nunca permite liberar (AR-A05, PR-07; UC-C02). Clase DE.</documentation>
      <property key="Evidencia" value="DE"/>
      <property key="Fase_ADM" value="C (Application)"/>
      <property key="Estado" value="Target"/>
    </element>
    <element xsi:type="archimate:ApplicationService" name="ASV-04 Gestión de excepciones y reconciliación" id="ASV-04">
