      </properties>
    </element>
    <element identifier="GAP-T06" xsi:type="Gap">
      <name xml:lang="es">GAP-T06 Almacenamiento y retención de evidencias</name>
      <documentation xml:lang="es">Baseline: Carpeta compartida sin política de retención (DS-CS-24). Target: T-TAR10 + TS-05. Resolución: Almacén append-only con integridad y retención configurable (NV-09). · Estado: Target (nuevo) · Clase DE</documentation>
