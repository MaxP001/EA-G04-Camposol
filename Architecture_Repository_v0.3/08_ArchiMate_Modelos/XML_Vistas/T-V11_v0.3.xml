        </property>
      </properties>
    </element>
    <element identifier="GAP-T02" xsi:type="Gap">
      <name xml:lang="es">GAP-T02 Separación de redes IT/OT</name>
      <documentation xml:lang="es">Baseline: LAN plana con oficina, calibradoras y frío (DS-CS-36). Target: Z-01…Z-07; CD-01…CD-09; T-TAR06/07; T-TAR14…18. Resolución: Zonas y conductos registrados; control OT local sin mando remoto. · Estado: Target (nuevo) · Clase DE</documentation>
      <properties>
        <property propertyDefinitionRef="PD-01">
          <value xml:lang="es">DE</value>
        </property>
        <property propertyDefinitionRef="PD-02">
          <value xml:lang="es">B–D (insumo E)</value>
        </property>
        <property propertyDefinitionRef="PD-03">
          <value xml:lang="es">Target (nuevo)</value>
        </property>
      </properties>
    </element>
    <element identifier="GAP-T03" xsi:type="Gap">
      <name xml:lang="es">GAP-T03 Identidad técnica y acceso</name>
      <documentation xml:lang="es">Baseline: Cuentas compartidas en OT; planilla editable por 14 usuarios (DS-CS-09/39). Target: T-TAR12 + TS-06. Resolución: Cuentas nominales por rol, MFA remoto, identidad de dispositivo y auditoría QA. · Estado: Target (nuevo) · Clase DE</documentation>
      <properties>
        <property propertyDefinitionRef="PD-01">
          <value xml:lang="es">DE</value>
