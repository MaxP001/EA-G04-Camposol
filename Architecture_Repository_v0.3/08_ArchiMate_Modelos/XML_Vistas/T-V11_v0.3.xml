        </property>
      </properties>
    </element>
    <element identifier="GAP-T04" xsi:type="Gap">
      <name xml:lang="es">GAP-T04 Recuperabilidad de la plataforma</name>
      <documentation xml:lang="es">Baseline: Servidor único; respaldo semanal sin prueba de restauración (DS-CS-35/38). Target: T-TAR08…11 + TS-08/09. Resolución: Plataforma central con RTO/RPO, respaldo inmutable, observabilidad y versionado. · Estado: Target (nuevo) · Clase DE</documentation>
      <properties>
        <property propertyDefinitionRef="PD-01">
          <value xml:lang="es">DE</value>
        </property>
        <property propertyDefinitionRef="PD-02">
          <value xml:lang="es">B–D (insumo E)</value>
        </property>
        <property propertyDefinitionRef="PD-03">
          <value xml:lang="es">Target (nuevo)</value>
        </property>
      </properties>
    </element>
    <element identifier="GAP-T05" xsi:type="Gap">
      <name xml:lang="es">GAP-T05 Tiempo de referencia</name>
      <documentation xml:lang="es">Baseline: Relojes sin fuente común; deriva de hasta 4 min (DS-CS-22/40). Target: T-TAR05 + TS-07 + CD-09. Resolución: Servidor de tiempo de planta; desviación ≤ 1 s; zona explícita. · Estado: Target (nuevo) · Clase DE</documentation>
