  <elements>
    <element identifier="CAP-01" xsi:type="Capability"><name xml:lang="es">CAP-01 Trazabilidad del lote</name><documentation xml:lang="es">Habilidad de identificar cada unidad física y reconstruir su historia y genealogía desde la recepción hasta el FCL.</documentation></element>
    <element identifier="BSV-01" xsi:type="BusinessService"><name xml:lang="es">BSV-01 Historial auditable del lote</name><documentation xml:lang="es">Estado: Target; Gap: New</documentation></element>
    <element identifier="BP-04" xsi:type="BusinessProcess"><name xml:lang="es">BP-04 Reconstruir historia del lote</name><documentation xml:lang="es">Estado: Target; Gap: New</documentation></element>
    <element identifier="ASV-02" xsi:type="ApplicationService"><name xml:lang="es">ASV-02 Consulta autorizada de historia</name></element>
    <element identifier="DOBJ-12" xsi:type="DataObject"><name xml:lang="es">DOBJ-12 LotHistory</name><documentation xml:lang="es">Vista consolidada y consultable de identidad, genealogía, eventos, inspección, frío y despacho de un lote, con procedencia.</documentation></element>
    <element identifier="AF-02" xsi:type="ApplicationFunction"><name xml:lang="es">AF-02 Componer historia del lote</name></element>
    <element identifier="AP-09" xsi:type="ApplicationComponent"><name xml:lang="es">AP-09 Componente de trazabilidad</name><documentation xml:lang="es">Target · Componer identidad, genealogía e historia; publicar estado QA · Disposición: Incorporar (ABB lógico) · Clase D</documentation></element>
    <element identifier="ART-03" xsi:type="Artifact"><name xml:lang="es">ART-03 Paquete de trazabilidad</name><documentation xml:lang="es">Despliegue de AP-09 en T-TAR09. · Estado: Target (nuevo) · Clase D</documentation></element>
    <element identifier="T-TAR09" xsi:type="Node"><name xml:lang="es">T-TAR09 Plataforma central de ejecución</name><documentation xml:lang="es">Zona Z-06 (DC o nube, NV-10). Ejecuta AP-08 central, AP-09, AP-10 y AP-11. · Estado: Target (nuevo) · Clase D</documentation></element>
    <element identifier="TS-06" xsi:type="TechnologyService"><name xml:lang="es">TS-06 Identidad y control de acceso</name><documentation xml:lang="es">Cuentas nominales, MFA, grupos por rol (ROL-B01…B08) e identidad de dispositivo. · Estado: Target (nuevo) · Clase D</documentation></element>
    <element identifier="AP-08" xsi:type="ApplicationComponent"><name xml:lang="es">AP-08 Ingesta y adaptadores de eventos</name><documentation xml:lang="es">Target · Validar contrato, deduplicar y correlacionar eventos · Disposición: Incorporar (ABB lógico, sin producto) · Clase D</documentation></element>
    <element identifier="ART-01" xsi:type="Artifact"><name xml:lang="es">ART-01 Paquete de ingesta de borde</name><documentation xml:lang="es">Despliegue de AP-08 en T-TAR03 (adaptadores y validación de contrato en planta). · Estado: Target (nuevo) · Clase D</documentation></element>
    <element identifier="T-TAR03" xsi:type="Node"><name xml:lang="es">T-TAR03 Nodo de borde de planta (par redundante)</name><documentation xml:lang="es">Zona Z-03. Cola persistente, ingesta de borde y réplica de lectura; autonomía ≥ 24 h ante corte WAN (PD-01). · Estado: Target (nuevo) · Clase D</documentation></element>
    <element identifier="TS-02" xsi:type="TechnologyService"><name xml:lang="es">TS-02 Almacenamiento y reenvío de eventos</name><documentation xml:lang="es">Store-and-forward con eventId estable, orden por lote y reintento idempotente. · Estado: Target (nuevo) · Clase D</documentation></element>
    <element identifier="CAP-07" xsi:type="Capability"><name xml:lang="es">CAP-07 Control de conformidad y liberación</name><documentation xml:lang="es">Habilidad de inspeccionar el producto y decidir liberar, retener o rechazar con autoridad exclusiva y evidencia.</documentation></element>
    <element identifier="BSV-05" xsi:type="BusinessService"><name xml:lang="es">BSV-05 Decisión de conformidad</name><documentation xml:lang="es">Estado: Ambos; Gap: Included (modificado)</documentation></element>
    <element identifier="BP-03" xsi:type="BusinessProcess"><name xml:lang="es">BP-03 Inspeccionar y decidir conformidad</name><documentation xml:lang="es">Estado: Ambos; Gap: Included (modificado)</documentation></element>
    <element identifier="AP-04" xsi:type="ApplicationComponent"><name xml:lang="es">AP-04 Registro de Calidad (planilla)</name><documentation xml:lang="es">Baseline · Registrar inspección y decisión · Disposición: Modernizar captura (candidato) conservando autoridad · Clase S</documentation></element>
    <element identifier="T-TAR02" xsi:type="Device"><name xml:lang="es">T-TAR02 Estaciones de captura en punto</name><documentation xml:lang="es">Recepción, packing y laboratorio de Calidad; ejecutan AP-01/03/04 modernizados con cuenta nominal. · Estado: Target (nuevo) · Clase D</documentation></element>
